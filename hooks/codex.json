{
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/guard.py\" start codex" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/guard.py\" prompt codex" }] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "python3 \"${PLUGIN_ROOT}/scripts/guard.py\" pretool codex" }] }
    ]
  }
}
